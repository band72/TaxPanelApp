<Window x:Class="MapSearchApp.ImageDisplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Map Region Screenshot" Height="500" Width="1000" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock x:Name="OcrResultText" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" Foreground="DarkBlue" TextWrapping="Wrap"/>
        
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            
            <GroupBox Header="Context (Original Image)" Grid.Column="0">
                <Border BorderBrush="Black" BorderThickness="1" Background="White">
                    <Viewbox Stretch="Uniform">
                        <Grid Width="{Binding ActualWidth, ElementName=ContextImageViewer}" Height="{Binding ActualHeight, ElementName=ContextImageViewer}">
                            <Image x:Name="ContextImageViewer" Stretch="None" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <Canvas x:Name="HighlightCanvas" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <Rectangle x:Name="TargetHighlight" Stroke="Red" StrokeThickness="4" Fill="#40FF0000" IsHitTestVisible="False"/>
                            </Canvas>
                        </Grid>
                    </Viewbox>
                </Border>
            </GroupBox>
            
            <GroupBox Grid.Column="2">
                <GroupBox.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Target Panel (Zoomed)" Margin="0,0,10,0" VerticalAlignment="Center" FontWeight="Bold"/>
                        <Button Content="Zoom In (+)" Click="ZoomIn_Click" Width="75" Margin="0,0,5,0"/>
                        <Button Content="Zoom Out (-)" Click="ZoomOut_Click" Width="75" Margin="0,0,5,0"/>
                    </StackPanel>
                </GroupBox.Header>
                <Grid>
                    <Border BorderBrush="Black" BorderThickness="1" Background="White"
                            PreviewMouseLeftButtonDown="TargetPanel_PreviewMouseLeftButtonDown"
                            PreviewMouseMove="TargetPanel_PreviewMouseMove"
                            PreviewMouseLeftButtonUp="TargetPanel_PreviewMouseLeftButtonUp"
                            Cursor="SizeAll">
                        <Image x:Name="CroppedImageViewer" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" Background="#CCFFFFFF">
                        <TextBox x:Name="TifFilePathBox" Width="200" VerticalAlignment="Center" Margin="5" Padding="2" KeyDown="TifFilePathBox_KeyDown" ToolTip="Enter path to .tif image or use browse button"/>
                        <Button Content="..." Width="30" Height="24" VerticalAlignment="Center" Margin="0,5,5,5" Click="BrowseTif_Click" ToolTip="Browse for .tif image"/>
                    </StackPanel>
                </Grid>
            </GroupBox>
        </Grid>
        
        <Button Grid.Row="2" Content="Close" Width="100" Height="30" HorizontalAlignment="Center" Click="CloseButton_Click" Margin="0,10,0,0"/>
    </Grid>
</Window>
