<Window x:Class="MapSearchApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Panel Grid Search" Height="800" Width="1200" WindowState="Maximized"
        Background="#0F0F17"
        Icon="MapSearchApp.ico">
    
    <Window.Resources>
        <!-- ToolBtn -->
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark TextBox -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1C1C2E"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#313244"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ════════════════════════════════════════════════════════════
             ROW 0 — Top Toolbar
             ════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#11111B" BorderBrush="#313244" BorderThickness="0,0,0,1" Padding="10,6">
            <DockPanel LastChildFill="False">
                
                <!-- Brand -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="⬡" FontSize="18" Foreground="#89B4FA" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="MapSearch" FontSize="14" FontWeight="Bold" Foreground="#CDD6F4" VerticalAlignment="Center"/>
                    <TextBlock Text=" — Panel Grid" FontSize="12" Foreground="#585B70" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Search Input & Actions -->
                <WrapPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Panel Number:" VerticalAlignment="Center" FontSize="12" Foreground="#AABBCC" Margin="0,0,6,0"/>
                    <TextBox x:Name="PanelInput" Width="70" FontSize="13" Margin="0,0,8,0" Style="{StaticResource DarkTextBox}" KeyDown="PanelInput_KeyDown"/>
                    
                    <Button Content="Search" Style="{StaticResource ToolBtn}" Click="SearchButton_Click" Margin="0,0,6,0" Background="#1A2A4A" Foreground="#89B4FA" BorderBrush="#2A3A6A" FontWeight="SemiBold"/>
                    <Button Content="Base Map" Style="{StaticResource ToolBtn}" Click="BrowseMap_Click" Margin="0,0,6,0" Background="#3D2000" Foreground="#FAB387" BorderBrush="#5C3200"/>
                    
                    <Separator Width="1" Height="20" Background="#313244" Margin="4,0,10,0"/>
                    <Button Content="⚙ Settings" Style="{StaticResource ToolBtn}" Click="SettingsButton_Click" Margin="0,0,6,0" Background="#1C1C2E" Foreground="#CDD6F4" BorderBrush="#313244" ToolTip="Set TIFs Directory"/>
                    <Button x:Name="BtnCheckUpdates" Content="↑ Updates" Style="{StaticResource ToolBtn}" Click="CheckUpdates_Click" Margin="0,0,0,0" Background="#1A3A2A" Foreground="#A6E3A1" BorderBrush="#2A5A3A" ToolTip="Check for application updates"/>
                </WrapPanel>

                <!-- Status / Result -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1A3A1A" CornerRadius="4" Padding="10,4" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Result: " FontSize="12" Foreground="#A6E3A1" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ResultLabel" Text="-" FontSize="13" FontWeight="Bold" Foreground="#A6E3A1" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ════════════════════════════════════════════════════════════
             ROW 1 — Configuration Bar
             ════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="#11111B" BorderBrush="#1E1E2E" BorderThickness="0,0,0,1" Padding="10,6">
            <DockPanel>
                <TextBlock Text="Calibration Offsets:" VerticalAlignment="Center" FontSize="11" Foreground="#585B70" Margin="0,0,12,0"/>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Left:" FontSize="11" Foreground="#CDD6F4" VerticalAlignment="Center"/>
                    <Slider x:Name="LeftSlider" Width="80" Minimum="0" Maximum="300" Value="148" Margin="5,0,4,0" VerticalAlignment="Center" ValueChanged="Slider_ValueChanged"/>
                    <TextBlock x:Name="LeftVal" Text="{Binding ElementName=LeftSlider, Path=Value, StringFormat=F0}" FontSize="10" Foreground="#89B4FA" VerticalAlignment="Center" Width="30" Margin="0,0,15,0"/>

                    <TextBlock Text="Top:" FontSize="11" Foreground="#CDD6F4" VerticalAlignment="Center"/>
                    <Slider x:Name="TopSlider" Width="80" Minimum="0" Maximum="300" Value="145" Margin="5,0,4,0" VerticalAlignment="Center" ValueChanged="Slider_ValueChanged"/>
                    <TextBlock x:Name="TopVal" Text="{Binding ElementName=TopSlider, Path=Value, StringFormat=F0}" FontSize="10" Foreground="#89B4FA" VerticalAlignment="Center" Width="30" Margin="0,0,15,0"/>

                    <TextBlock Text="Right:" FontSize="11" Foreground="#CDD6F4" VerticalAlignment="Center"/>
                    <Slider x:Name="RightSlider" Width="80" Minimum="0" Maximum="300" Value="90" Margin="5,0,4,0" VerticalAlignment="Center" ValueChanged="Slider_ValueChanged"/>
                    <TextBlock x:Name="RightVal" Text="{Binding ElementName=RightSlider, Path=Value, StringFormat=F0}" FontSize="10" Foreground="#89B4FA" VerticalAlignment="Center" Width="30" Margin="0,0,15,0"/>

                    <TextBlock Text="Bottom:" FontSize="11" Foreground="#CDD6F4" VerticalAlignment="Center"/>
                    <Slider x:Name="BottomSlider" Width="80" Minimum="0" Maximum="300" Value="140" Margin="5,0,4,0" VerticalAlignment="Center" ValueChanged="Slider_ValueChanged"/>
                    <TextBlock x:Name="BottomVal" Text="{Binding ElementName=BottomSlider, Path=Value, StringFormat=F0}" FontSize="10" Foreground="#89B4FA" VerticalAlignment="Center" Width="30" Margin="0,0,15,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <CheckBox x:Name="ShowGridCheck" Content="Show Reference Grid" FontSize="11" Foreground="#CDD6F4" VerticalAlignment="Center" Checked="ShowGridCheck_Changed" Unchecked="ShowGridCheck_Changed"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ════════════════════════════════════════════════════════════
             ROW 2 — Map Area
             ════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="#0A0A12" BorderBrush="#1E1E2E" BorderThickness="1,0,0,0">
            <ScrollViewer x:Name="MapScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          PreviewMouseLeftButtonDown="MapScrollViewer_PreviewMouseLeftButtonDown"
                          PreviewMouseMove="MapScrollViewer_PreviewMouseMove"
                          PreviewMouseLeftButtonUp="MapScrollViewer_PreviewMouseLeftButtonUp">
                <Viewbox Stretch="Uniform">
                    <Grid x:Name="MapContainer" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20">
                        <Image x:Name="MapImage" Source="map.png" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <Canvas x:Name="OverlayCanvas" Width="{Binding ElementName=MapImage, Path=ActualWidth}" Height="{Binding ElementName=MapImage, Path=ActualHeight}" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <!-- Red Bounding Box for Highlight -->
                            <Rectangle x:Name="HighlightBox" Stroke="#F38BA8" StrokeThickness="4" Fill="#33F38BA8" Visibility="Hidden" IsHitTestVisible="False"/>
                        </Canvas>
                    </Grid>
                </Viewbox>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
